{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Cask engine profile selection (v1/v2; v2 = K55 recorded choice, Godot 3.x/4.x)",
  "type": "object",
  "required": [
    "schema",
    "allowed",
    "adapter",
    "runtime",
    "version",
    "build",
    "runner",
    "runnerSha256",
    "pack",
    "renderer",
    "threads"
  ],
  "properties": {
    "schema": {
      "enum": [
        "game-cask/engine-profile/1",
        "game-cask/engine-profile/2"
      ]
    },
    "allowed": {
      "const": true
    },
    "adapter": {
      "type": "string",
      "enum": [
        "godot3",
        "godot4"
      ]
    },
    "runtime": {
      "type": "string",
      "description": "Runtime id from tools/engine/runtimes.json, e.g. godot-4.3-nothreads (alias godot-3.5.3)."
    },
    "version": {
      "type": "string",
      "pattern": "^[34]\\.[0-9]+(\\.[0-9]+)?$"
    },
    "build": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "inputRoot": {
      "type": "string"
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "runnerSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pack": {
      "type": "object",
      "required": [
        "location",
        "sha256"
      ],
      "properties": {
        "location": {
          "enum": [
            "embedded-trailer",
            "embedded-section",
            "adjacent",
            "explicit"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "renderer": {
      "enum": [
        "webgl2",
        "webgl"
      ]
    },
    "threads": {
      "type": "boolean",
      "description": "Must equal the runtime variant: true selects a threaded web runtime (served with COOP/COEP)."
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "choice": {
      "type": "string",
      "maxLength": 500,
      "description": "The porter's recorded reason for choosing the engine runtime (no operator authorization since K55)."
    },
    "allowUnverifiedRuntime": {
      "type": "boolean",
      "description": "Recorded opt-in to build/serve with a runtime whose release publishes no checksum (verification manifest-crc32)."
    }
  },
  "$comment": "Runtime manifest supplies renderer/thread/header requirements and pinned official archive/member/notice hashes. Build validates exact pairing."
}
