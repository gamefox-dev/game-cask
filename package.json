{
  "name": "game-cask",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first starter kit for restoring legally obtained legacy games as browser experiences via the Game Cask Browser Target (BGT).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "node tools/build/install-hooks.mjs",
    "doctor": "node tools/build/check-toolchain.mjs",
    "build:games": "node tools/build/build.mjs --all",
    "build:sample": "node tools/build/build.mjs examples/sample2d",
    "build:port": "node tools/build/build.mjs port",
    "dev": "npm run build:games && vite",
    "build": "npm run build:games && vite build",
    "preview": "vite preview",
    "bundle": "node tools/build/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node tools/build/build.mjs --all --check",
    "test": "vitest run",
    "test:e2e": "npm run build:games && playwright test",
    "test:e2e:webgl2": "npm run build:games && playwright test --project=chromium-webgl2",
    "test:e2e:webgpu": "npm run build:games && BGT_REQUIRE_WEBGPU=1 playwright test --project=chromium-webgpu",
    "test:port": "npm run build:port && BGT_RESULTS_PREFIX=e2e-port playwright test --project=port-webgl2 --project=port-webgpu",
    "inspect": "node tools/inspect/inspect.mjs",
    "report": "node tools/report/report.mjs",
    "leakcheck": "node tools/report/leakcheck.mjs",
    "bench": "npm run build:games && node tools/bench/bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@webgpu/types": "0.1.74",
    "binaryen": "132.0.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
